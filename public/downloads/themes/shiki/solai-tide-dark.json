IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n\nOriginal Dolch palettes: Renzhi Li (Belleve Invis). https://github.com/be5invis/vscode-theme-dolch\nTide retains upstream Blue primitives; Ember uses original Alter custom ramps with the shared Blue base. Dusk, Viridian, Bloom and the application mappings are Solai studies.",
  "name": "solai-tide-dark",
  "displayName": "Solai Tide Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#101416",
    "editor.foreground": "#B0B4B7"
  },
  "tokenColors": [
    {
      "name": "Neutral source and embedded code",
      "scope": ["source", "meta.embedded"],
      "settings": {
        "foreground": "#B0B4B7",
        "fontStyle": ""
      }
    },
    {
      "name": "Readable comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#9A9EA0",
        "fontStyle": ""
      }
    },
    {
      "name": "Neutral bold grammar",
      "scope": ["keyword", "storage", "variable.language"],
      "settings": {
        "foreground": "#DFE3E6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Sparse operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#7BF2FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators remain grammar",
      "scope": [
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "keyword.operator.typeof",
        "keyword.operator.instanceof"
      ],
      "settings": {
        "foreground": "#DFE3E6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Neutral identifiers, including constants",
      "scope": [
        "variable",
        "entity.name.variable",
        "support.variable",
        "support.constant",
        "constant.other",
        "entity.name.namespace",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#B0B4B7",
        "fontStyle": ""
      }
    },
    {
      "name": "Neutral callable names",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#C7CBCE",
        "fontStyle": ""
      }
    },
    {
      "name": "Neutral members and object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.constant.property",
        "variable.other.enummember",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#B0B4B7",
        "fontStyle": ""
      }
    },
    {
      "name": "Companion types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.builtin",
        "storage.type.numeric",
        "storage.type.string",
        "storage.type.boolean"
      ],
      "settings": {
        "foreground": "#3EC6C4",
        "fontStyle": ""
      }
    },
    {
      "name": "Quoted data",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#00ACCE",
        "fontStyle": ""
      }
    },
    {
      "name": "Literal values",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#5CDAFC",
        "fontStyle": ""
      }
    },
    {
      "name": "Readable delimiters",
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#9A9EA0",
        "fontStyle": ""
      }
    },
    {
      "name": "Quoted delimiters follow their data",
      "scope": ["punctuation.definition.string"],
      "settings": {
        "foreground": "#00ACCE",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation delimiters",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#9A9EA0",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation code",
      "scope": ["meta.template.expression"],
      "settings": {
        "foreground": "#B0B4B7",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#DFE3E6",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#B0B4B7",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": {
        "foreground": "#B0B4B7",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#B0B4B7",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown body",
      "scope": ["text.html.markdown"],
      "settings": {
        "foreground": "#C7CBCE",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "#DFE3E6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown strong",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#C7CBCE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#C7CBCE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong emphasis",
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": {
        "foreground": "#C7CBCE",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown quotations",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#B0B4B7",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#3EC6C4",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": {
        "foreground": "#00ACCE",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown list markers",
      "scope": ["punctuation.definition.list.begin.markdown"],
      "settings": {
        "foreground": "#00ACCE",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown fences",
      "scope": [
        "punctuation.definition.markdown",
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#9A9EA0",
        "fontStyle": ""
      }
    },
    {
      "name": "Inserted diff text",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#5FC886",
        "fontStyle": ""
      }
    },
    {
      "name": "Removed diff text",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#FF9285",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed diff text",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#00ACCE",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff headers",
      "scope": ["meta.diff.header", "meta.diff.range"],
      "settings": {
        "foreground": "#9A9EA0",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid syntax",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FF9285",
        "fontStyle": ""
      }
    },
    {
      "name": "Deprecated syntax",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#9A9EA0",
        "fontStyle": ""
      }
    }
  ]
}
