---
interface Props {
  title: string;
  description?: string;
  flavor?: string;
  mode?: 'dark' | 'light';
}

const { title, description, flavor, mode = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="en" data-flavor={flavor} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#101416" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
