---
import '../styles/main.css';
interface Props {
  title: string;
  description: string;
  flavor?: string;
  mode?: 'dark' | 'light';
  noindex?: boolean;
}

const { title, description, flavor, mode = 'dark', noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL('/assets/og-image.png', Astro.site);
const imageAlt = 'Solai with Editor and Terminal colour specimens in Tide Dark.';
const siteJSON = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Solai',
  url: new URL('/', Astro.site).href,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-flavor={flavor} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#101416" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <title>{title}</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solai" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {Astro.url.pathname === '/' && <script is:inline type="application/ld+json" set:html={siteJSON} />}
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://stats.ovy.sh/script.js"
        data-website-id="bad70cb9-2574-4746-80bc-f7baaeb56d0c"
        data-domains="solai.style"
        data-exclude-search="true"
        data-exclude-hash="true"
      ></script>
    )}
    <slot name="head" />
  </head>
  <body class="m-0 bg-solai-surface-canvas font-sans text-[16px] leading-[1.6] text-solai-text-primary [@media(max-width:650px)]:text-[14px]">
    <slot />
  </body>
</html>
