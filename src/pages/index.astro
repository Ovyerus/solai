---
import Page from '../layouts/Page.astro';
import AppSamples from '../components/AppSamples.astro';
import AppearanceControl from '../components/AppearanceControl.astro';
import '../styles/main.css';
import '../styles/themes.css';
---

<Page
  title="Solai — colour themes"
  description="Five colour themes in light and dark, with palette previews and CSS and JSON downloads."
  flavor="blue"
>
  <Fragment slot="head">
    <link rel="preload" href="/assets/fonts/Sora.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      let flavor = 'blue';
      let mode = 'dark';
      try {
        flavor = localStorage.getItem('solai.flavour') || flavor;
        mode = localStorage.getItem('solai.mode') || mode;
      } catch (error) {}
      const query = new URLSearchParams(location.search);
      const requestedTheme = query.get('theme');
      if (requestedTheme) {
        const names = { tide: 'blue', ember: 'alter', dusk: 'violet', viridian: 'green', bloom: 'rose' };
        flavor = names[requestedTheme.toLowerCase()] || requestedTheme;
      }
      mode = query.get('mode') || mode;
      document.documentElement.dataset.flavor = ['blue', 'alter', 'violet', 'green', 'rose'].includes(flavor) ? flavor : 'blue';
      document.documentElement.dataset.mode = ['dark', 'light'].includes(mode) ? mode : 'dark';
    </script>
  </Fragment>

  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="wordmark" href="#" aria-label="Solai home">solai<span class="mark">✳</span></a>
    <nav aria-label="Main">
      <div class="nav-links">
        <a href="#flavours">Flavours</a>
        <a href="#examples">Previews</a>
        <a href="#palette">Palette</a>
        <a href="#take-it">Downloads <span>↗</span></a>
      </div>
      <select id="theme-select" class="theme-select" aria-label="Colour theme" disabled>
        <option value="blue">Tide</option>
        <option value="alter">Ember</option>
        <option value="violet">Dusk</option>
        <option value="green">Viridian</option>
        <option value="rose">Bloom</option>
      </select>
    </nav>
    <AppearanceControl />
  </header>

  <main id="main">
    <section class="hero" aria-label="Solai introduction">
      <div class="hero-art">
        <canvas id="landscape" width="1440" height="760" aria-label="An abstract mountain lake, rendered in the selected theme colours">A mountain lake rendered in the current theme.</canvas>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-heading wrap">
          <h1>solai<span>✳</span></h1>
          <p>Light on water.<br />Colour on screen.</p>
        </div>
        <div class="effect-controls" role="group" aria-label="Image treatment">
          <button data-effect="soft" aria-pressed="false">Soft</button>
          <button data-effect="dither" class="active" aria-pressed="true">Dither</button>
          <button data-effect="ascii" aria-pressed="false">ASCII</button>
        </div>
      </div>
    </section>

    <section id="flavours" class="wrap section">
      <div class="section-top section-heading">
        <h2>Flavours</h2>
      </div>
      <div id="flavour-list" class="flavour-list" role="group" aria-label="Choose a theme"></div>
      <div class="flavour-caption">
        <span id="flavour-description"></span>
        <span id="flavour-origin" class="tag"></span>
      </div>
    </section>

    <AppSamples />

    <section id="palette" class="wrap section">
      <div class="section-top section-heading">
        <h2>Palette</h2>
        <button class="text-button" id="copy-css">Copy theme CSS ↗</button>
      </div>
      <p class="muted">Click a swatch to copy its hex value.</p>
      <div class="palette-heading">
        <h3>Surfaces &amp; type</h3>
      </div>
      <div id="neutral-swatches" class="swatch-grid neutrals"></div>
      <div class="palette-heading">
        <h3>Accents</h3>
      </div>
      <div id="accent-swatches" class="swatch-grid"></div>
      <details class="ramps">
        <summary><span>Explore all 17 generated ramps</span><span>11 GRADES EACH &nbsp; +</span></summary>
        <p>Grades run from background to foreground: dark to bright in dark mode, light to dark in light mode. Check contrast for the surface you use.</p>
        <div id="ramps-table"></div>
      </details>
      <div class="contrast-specimen">
        <div>
          <span class="mono muted">BUTTON LABEL</span>
          <strong id="button-ratio">6.87:1</strong>
          <span>text contrast</span>
        </div>
        <button class="primary" id="contrast-button">Downloads ↗</button>
      </div>
      <p class="muted"><span id="contrast-count">21</span> selected contrast pairs checked per flavour; not a complete accessibility audit.</p>
    </section>

    <section id="take-it" class="wrap section downloads">
      <div class="section-top section-heading">
        <h2>Downloads</h2>
        <span class="tag">EXPERIMENTAL / v0.1</span>
      </div>
      <p class="muted">Palette data and CSS variables; no app installers.</p>
      <div class="download-list">
        <button data-download="json">
          <span><strong>Current palette</strong><small><span class="current-name">Tide</span> <span class="current-mode">Dark</span> · primitives, semantic roles &amp; provenance</small></span>
          <span>JSON ↗</span>
        </button>
        <button data-download="css">
          <span><strong>Current theme variables</strong><small>Copy into a web project and map to your components</small></span>
          <span>CSS ↗</span>
        </button>
        <button data-download="all">
          <span><strong>All palettes</strong><small>Five flavours · light &amp; dark · source parameters · contrast checks</small></span>
          <span>JSON ↗</span>
        </button>
        <a href="/downloads/dolch-reference-starter.zip" download>
          <span><strong>Original reference &amp; generators</strong><small>Earlier Dolch-labelled starter · MIT notice · Python scripts</small></span>
          <span>ZIP ↗</span>
        </a>
      </div>
    </section>

    <footer class="wrap">
      <div class="footer-top">
        <a class="wordmark" href="#">solai<span class="mark">✳</span></a>
      </div>
      <div class="footer-meta">
        <p>Tide &amp; Ember: <a href="https://github.com/be5invis/vscode-theme-dolch" target="_blank" rel="noreferrer">Dolch by Renzhi Li</a> · <a href="/downloads/LICENSE-Dolch.txt">MIT</a><br />Presentation: <a href="https://madoromi.moonwit.ch/" target="_blank" rel="noreferrer">madoromi</a> · <a href="https://doll.systems" target="_blank" rel="noreferrer">doll.systems</a>.<br />Fonts: <a href="/assets/fonts/Sora-OFL.txt">Sora</a> · <a href="/assets/fonts/IosevkaSolai-LICENSE.txt">Iosevka Solai</a>.</p>
        <a href="#">BACK TO TOP ↑</a>
      </div>
    </footer>
  </main>

  <div id="toast" role="status" aria-live="polite"></div>
  <dialog id="copy-dialog">
    <form method="dialog">
      <button class="dialog-close" aria-label="Close">×</button>
      <h3>Copy this colour data</h3>
      <p>Your browser couldn’t copy automatically. Select the text below.</p>
      <textarea id="copy-fallback" readonly></textarea>
      <button class="primary">Done</button>
    </form>
  </dialog>
  <noscript><p class="wrap">Enable JavaScript to switch palettes, explore colours and download theme data.</p></noscript>
  <script>
    import '../scripts/app.js';
  </script>
</Page>
