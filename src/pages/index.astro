---
import Page from '../layouts/Page.astro';
import AppSamples from '../components/AppSamples.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeHead from '../components/ThemeHead.astro';
import Wordmark from '../components/Wordmark.astro';
const sectionHeading = 'section-top section-heading my-[27px] mb-[38px] flex items-end justify-between gap-[48px] border-t border-solai-border-subtle py-[19px] [@media(max-width:1000px)]:gap-[30px] [@media(max-width:650px)]:my-[22px] [@media(max-width:650px)]:mb-[25px] [@media(max-width:650px)]:block [@media(max-width:650px)]:py-[15px]';
---

<Page
  title="Solai — colour themes"
  description="Five colour themes in light and dark, with editor and terminal ports, palette previews, CSS, JSON and Tailwind colour tokens."
  flavor="blue"
>
  <ThemeHead slot="head" />
  <SiteHeader home />

  <main id="main">
    <section class="hero m-0 w-full max-w-none pt-0" aria-label="Solai introduction">
      <div class="hero-art relative isolate h-[clamp(420px,72svh,760px)] w-full overflow-hidden border-0 border-b border-solai-border-subtle bg-solai-surface-canvas bg-[url('/assets/balcony-dither.png')] bg-cover bg-center [@media(max-width:650px)]:h-[clamp(390px,70svh,620px)] [@media(max-width:650px)]:bg-[position:8%_center]">
        <canvas class="absolute inset-0 z-0 block h-full w-full opacity-0 data-[ready=true]:opacity-100 [image-rendering:pixelated]" id="hero-canvas" width="1440" height="760" role="img" aria-label="A planted high-rise balcony overlooking a mountain lake, the sun and ridge wind turbines, in ordered-dithered theme colours">A planted balcony above a mountain lake. Static Tide Dark dithering is shown when live rendering is unavailable.</canvas>
        <div class="hero-shade pointer-events-none absolute inset-0 z-[1]" aria-hidden="true"></div>
        <div class="hero-heading wrap pointer-events-none absolute bottom-[55px] left-1/2 z-[2] m-0 flex -translate-x-1/2 flex-col items-start gap-[24px] [@media(max-width:650px)]:bottom-[32px] [@media(max-width:650px)]:gap-[19px]">
          <h1 class="m-0 -ml-[7px] w-[2.31em] text-[clamp(105px,13vw,190px)] leading-[0] text-solai-text-emphasis [@media(max-width:650px)]:-ml-[4px] [@media(max-width:650px)]:text-[clamp(88px,24vw,145px)]" aria-label="Solai"><Wordmark /></h1>
          <p class="m-0 max-w-[70%] font-sans text-[clamp(20px,2.2vw,29px)] font-normal leading-[1.4] tracking-[-.03em] text-solai-text-emphasis [@media(max-width:650px)]:max-w-full [@media(max-width:650px)]:text-[20px]">Light on water.<br />Colour on screen.</p>
        </div>
      </div>
    </section>

    <section class="wrap section pt-[80px] [@media(max-width:650px)]:pt-[50px]" aria-label="About Solai">
      <p class="m-0 max-w-[880px] text-[clamp(22px,2.6vw,32px)] leading-[1.5] tracking-[-.035em] text-solai-text-emphasis">Solai is a fork of <a class="underline decoration-solai-accent-primary underline-offset-[5px] hover:text-solai-accent-hover" href="https://github.com/be5invis/vscode-theme-dolch" target="_blank" rel="noreferrer">Dolch</a>: Renzhi Li’s theme for VSCode, with defined colour scales and alternate colour schemes.</p>
      <p class="mt-[24px] mb-0 max-w-[760px] text-[clamp(16px,1.6vw,20px)] leading-[1.8] text-solai-text-secondary">The mood is solarpunk after sunset. Synths through an open window, greenhouse light on concrete, harbour lights across the water. A city still awake, with room for things to grow.</p>
    </section>

    <section id="flavours" class="wrap section pt-[80px] [@media(max-width:650px)]:pt-[50px]">
      <div class={sectionHeading}>
        <h2 class="m-0 font-sans text-[clamp(29px,3.4vw,46px)] font-normal leading-[1.14] tracking-[-.035em] text-solai-text-emphasis [@media(max-width:650px)]:text-[31px]">Flavours</h2>
      </div>
      <div id="flavour-list" class="flavour-list grid grid-cols-5 gap-px rounded-[2px] border border-solai-border-strong bg-solai-border-subtle [@media(max-width:650px)]:grid-cols-2" role="group" aria-label="Choose a theme"></div>
      <p id="flavour-description" class="flavour-caption m-0 py-[17px] text-[13px] text-solai-text-secondary [@media(max-width:650px)]:text-[11px]"></p>
    </section>

    <AppSamples />

    <SiteFooter />
  </main>

  <div id="toast" class="pointer-events-none fixed bottom-[25px] left-1/2 z-50 max-w-[90vw] -translate-x-1/2 translate-y-[20px] rounded-[2px] border border-solai-accent-primary bg-solai-accent-primary px-[20px] py-[12px] text-center font-sans text-[12px] leading-[normal] text-solai-accent-ink opacity-0 transition-[opacity,transform,translate] duration-200 ease-[ease] [&.visible]:translate-y-0 [&.visible]:opacity-100" role="status" aria-live="polite"></div>
  <noscript><p class="wrap my-[1em]">Enable JavaScript to switch palettes and load the flavour cards. <a class="underline underline-offset-[4px] hover:text-solai-accent-hover" href="/downloads/">Theme downloads</a> remain available without JavaScript.</p></noscript>
  <script>
    import '../scripts/app.js';
  </script>
</Page>
