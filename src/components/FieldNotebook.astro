              <path d="M28 188 H191" fill="none" stroke="var(--strong)" stroke-width="1" stroke-dasharray="3 5" />
              <path d="M109 188 L110 220 M110 201 L96 211 L91 223 M110 211 L125 221 L130 232 M110 219 L105 235 M99 208 L88 210" fill="none" stroke="var(--support)" stroke-width="1.2" stroke-linecap="round" />
