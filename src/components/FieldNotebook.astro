              <path d="M111 112 C112 82 139 65 164 68 C166 94 143 113 111 112 Z" fill="var(--canvas)" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M114 110 L155 76 M133 94 L133 80 M133 94 L150 96" fill="none" stroke="var(--accent)" stroke-width="1" stroke-linecap="round" />
              <path d="M116 62 C96 57 84 41 87 22 C108 23 121 40 116 62 Z" fill="var(--canvas)" stroke="var(--support)" stroke-width="1.5" stroke-linejoin="round" />
